        self.scale_slider.sliderReleased.connect(self.trigger_update)
        self.lbl_scale = QLabel("4x"); self.lbl_scale.setFixedWidth(30)
        h_slide.addWidget(self.scale_slider); h_slide.addWidget(self.lbl_scale)
        lay_dither.addLayout(h_slide)

        lay_dither.addStretch()
        self.toolbox.addItem(page_dither, "1. Dither Settings")

        # 2. Pre-Process
        page_pre = QWidget(); lay_pre = QVBoxLayout(page_pre)

        lbl_br = QLabel("Brightness:"); lbl_br.setProperty("role", "title")
        lay_pre.addWidget(lbl_br)
        h_br = QHBoxLayout()
        self.br_slider = QSlider(Qt.Horizontal); self.br_slider.setRange(-50, 50); self.br_slider.setValue(0)
        self.br_slider.valueChanged.connect(lambda v: self.lbl_br_val.setText(str(v)))
        self.br_slider.sliderReleased.connect(self.trigger_update)
        self.lbl_br_val = QLabel("0"); self.lbl_br_val.setFixedWidth(30)
        h_br.addWidget(self.br_slider); h_br.addWidget(self.lbl_br_val)
        lay_pre.addLayout(h_br)

        lbl_ct = QLabel("Contrast:"); lbl_ct.setProperty("role", "title")
        lay_pre.addWidget(lbl_ct)
        h_ct = QHBoxLayout()
        self.ct_slider = QSlider(Qt.Horizontal); self.ct_slider.setRange(5, 20); self.ct_slider.setValue(10)
        self.ct_slider.valueChanged.connect(lambda v: self.lbl_ct_val.setText(f"{v/10.0}"))
        self.ct_slider.sliderReleased.connect(self.trigger_update)
        self.lbl_ct_val = QLabel("1.0"); self.lbl_ct_val.setFixedWidth(30)
        h_ct.addWidget(self.ct_slider); h_ct.addWidget(self.lbl_ct_val)
        lay_pre.addLayout(h_ct)

        lay_pre.addStretch()
        self.toolbox.addItem(page_pre, "2. Pre-Process")

        # 3. Effects (Bloom)
        page_fx = QWidget(); lay_fx = QVBoxLayout(page_fx)

        lbl_bi = QLabel("Bloom Intensity:"); lbl_bi.setProperty("role", "title")
        lay_fx.addWidget(lbl_bi)
        h_bloom = QHBoxLayout()
        self.bloom_int_slider = QSlider(Qt.Horizontal); self.bloom_int_slider.setRange(0, 100); self.bloom_int_slider.setValue(0)
        self.bloom_int_slider.valueChanged.connect(self.update_bloom_label)
        self.bloom_int_slider.sliderReleased.connect(self.trigger_update)
        self.lbl_bloom_int = QLabel("0"); self.lbl_bloom_int.setFixedWidth(30)
        h_bloom.addWidget(self.bloom_int_slider); h_bloom.addWidget(self.lbl_bloom_int)
        lay_fx.addLayout(h_bloom)

        lbl_br = QLabel("Bloom Radius:"); lbl_br.setProperty("role", "title")
        lay_fx.addWidget(lbl_br)
        h_rad = QHBoxLayout()
        self.bloom_rad_slider = QSlider(Qt.Horizontal); self.bloom_rad_slider.setRange(1, 50); self.bloom_rad_slider.setValue(10)
        self.bloom_rad_slider.valueChanged.connect(self.update_rad_label)
        self.bloom_rad_slider.sliderReleased.connect(self.trigger_update)
        self.lbl_bloom_rad = QLabel("10"); self.lbl_bloom_rad.setFixedWidth(30)
        h_rad.addWidget(self.bloom_rad_slider); h_rad.addWidget(self.lbl_bloom_rad)
        lay_fx.addLayout(h_rad)

        lay_fx.addStretch()
        self.toolbox.addItem(page_fx, "3. Glow / Bloom")

        left_layout.addWidget(self.toolbox)

        btn_sel = QPushButton("Process Selected"); btn_sel.clicked.connect(self.process_selected)
        btn_all = QPushButton("Process All"); btn_all.clicked.connect(self.process_all)
        left_layout.addWidget(btn_sel)
        left_layout.addWidget(btn_all)

        # RIGHT (Preview)
        right_layout = QVBoxLayout(); main_layout.addLayout(right_layout, 3)
        self.preview_widget = ZoomableImageWidget()
        right_layout.addWidget(self.preview_widget)

    # --- LOGIC ---

    def change_output_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Select Output Folder")
        if d:
            self.output_dir = Path(d)
            self.output_label.setText(f"{self.output_dir}")
            QMessageBox.information(self, "Success", f"Output folder changed to:\n{self.output_dir}")

    def on_palette_change(self, text):
        self.btn_pick_color.setVisible("Custom" in text)
        self.trigger_update()

    def pick_custom_colors(self):
        c1 = QColorDialog.getColor(QColor(*self.custom_col_1), self, "Pick Foreground")
        if c1.isValid():
            self.custom_col_1 = [c1.red(), c1.green(), c1.blue()]
            c2 = QColorDialog.getColor(QColor(*self.custom_col_2), self, "Pick Background")
            if c2.isValid():
                self.custom_col_2 = [c2.red(), c2.green(), c2.blue()]
                self.trigger_update()

    def update_scale_label(self, val): self.lbl_scale.setText(f"{val}x")
    def update_bloom_label(self, val): self.lbl_bloom_int.setText(str(val))
    def update_rad_label(self, val): self.lbl_bloom_rad.setText(str(val))

    def add_dropped_files(self, files):
        self.add_files(files)

    def add_images(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Select Images", "", IMAGE_FILTER)
        if not files: return
        self.add_files([Path(f) for f in files])

    def add_files(self, paths):
        # 1. SCAN & ASK (Only for non-GIFs)
        large_files = []
        for p in paths:
            if p.suffix.lower() == ".gif": continue
            try:
                with Image.open(p) as tmp:
                    tmp = ImageOps.exif_transpose(tmp)
                    if tmp.width > 1500 or tmp.height > 1500:
                        large_files.append(p)
            except: pass

        do_downscale = False
        if large_files:
            ans = QMessageBox.question(self, "Resolution Check",
                f"{len(large_files)} images are larger than 1500px.\n"
                "Downscaling is recommended for better effect.\n\n"
                "Auto-downscale to 1500px width?",
                QMessageBox.Yes | QMessageBox.No)
            if ans == QMessageBox.Yes: do_downscale = True

        prog = None
        if do_downscale:
            prog = QProgressDialog("Caching...", None, 0, len(paths), self)
            prog.setWindowModality(Qt.ApplicationModal); prog.show()

        for i, p in enumerate(paths):
            if p.suffix.lower() == ".gif":
                item = QListWidgetItem(p.name)
                item.setData(Qt.UserRole, p)
                self.file_list.addItem(item)
                self.image_paths.append(p)
                self.path_map[p] = p
                continue

            if do_downscale and p in large_files:
                try:
                    with Image.open(p) as img:
                        img = ImageOps.exif_transpose(img)
                        ratio = 1500 / float(img.width)
                        new_h = int(img.height * ratio)
                        img = img.resize((1500, new_h), Image.Resampling.LANCZOS)

                        cache_path = CACHE_DIR / f"{p.stem}_cached_1500px.png"
                        img.save(cache_path)

                        item = QListWidgetItem(f"{p.name} (Cached)")
                        item.setData(Qt.UserRole, cache_path)
                        self.file_list.addItem(item)
                        self.image_paths.append(cache_path)
                        self.path_map[cache_path] = p
                except Exception as e: print(e)
            else:
                item = QListWidgetItem(p.name)
                item.setData(Qt.UserRole, p)
                self.file_list.addItem(item)
                self.image_paths.append(p)
                self.path_map[p] = p

            if prog: prog.setValue(i+1)

        if prog: prog.close()
        if self.file_list.count() > 0 and self.file_list.currentRow() < 0:
            self.file_list.setCurrentRow(0)

    def clear_list(self):
        self.image_paths.clear(); self.file_list.clear(); self.path_map.clear()
        self.preview_proxy_img = None; self.loaded_proxy_path = ""
        # Clears the preview widget state
        self.preview_widget.set_image_pixmaps(None, None)
        try:
            for f in CACHE_DIR.glob("*"):
                try: os.remove(f)
                except: pass
        except: pass

    def on_file_selected(self, item):
        if not item: return
        real_path = item.data(Qt.UserRole)

        if real_path and str(real_path) != self.loaded_proxy_path:
            self.current_preview_path = real_path
            try:
                # Use shared widget logic for GIF playback if possible
                self.preview_widget.set_images(real_path, None)

                # But we also need a proxy for processing preview
                temp_img = Image.open(real_path)

                if getattr(temp_img, "is_animated", False):
                    temp_img.seek(0)

                temp_img = ImageOps.exif_transpose(temp_img)
                full_img = temp_img.convert("RGBA")

                # Create a proxy for display
                MAX_P = PREVIEW_MAX_SIZE
                w, h = full_img.size
                if max(w, h) > MAX_P:
                    ratio = min(MAX_P/w, MAX_P/h)
                    self.preview_proxy_img = full_img.resize((int(w*ratio), int(h*ratio)), Image.Resampling.BOX)
                else:
                    self.preview_proxy_img = full_img.copy()

                self.loaded_proxy_path = str(real_path)

                self.trigger_update()

            except Exception as e:
                print(f"Load Error: {e}")

    def trigger_update(self):
        self.debounce_timer.start()
        if self.meter: self.meter.set_message("Processing...")

    def start_preview_worker(self):
        if not self.preview_proxy_img: return

        # Collect Params
        params = {
            "scale": self.scale_slider.value(),
            "palette": self.palette_combo.currentText(),
            "mode": self.mode_combo.currentText(),
            "bloom_intensity": self.bloom_int_slider.value(),
            "bloom_radius": self.bloom_rad_slider.value(),
            "brightness": self.br_slider.value(),
            "contrast": self.ct_slider.value() / 10.0
        }

        self.preview_worker.set_data(self.preview_proxy_img, params, [self.custom_col_1, self.custom_col_2])
        self.preview_worker.start()

    def on_preview_ready(self, pix_res):
        if pix_res:
            self.preview_widget.set_result_pixmap(pix_res)

        if self.meter: self.meter.set_message(None)

    def ensure_output_dir(self, sample):
        if not self.output_dir:
            original_source = self.path_map.get(sample, sample)
            self.output_dir = original_source.parent / "LABOKit_Dither"
            self.output_dir.mkdir(exist_ok=True)
            self.output_label.setText(f"{self.output_dir}")
        return self.output_dir

    def process_selected(self):
        sel = self.file_list.selectedItems()
        if sel:
            targets = [i.data(Qt.UserRole) for i in sel]
            self._run_process(targets)

    def process_all(self):
        targets = [self.file_list.item(i).data(Qt.UserRole) for i in range(self.file_list.count())]
        self._run_process(targets)

    def _run_process(self, paths):
        if not paths: return
        out = self.ensure_output_dir(paths[0])

        dlg = QProgressDialog("Processing...", "Cancel", 0, len(paths), self)
        dlg.setWindowModality(Qt.ApplicationModal); dlg.show()

        worker = self.preview_worker

        # Collect Params
        params = {
            "scale": self.scale_slider.value(),
            "palette": self.palette_combo.currentText(),
            "mode": self.mode_combo.currentText(),
            "bloom_intensity": self.bloom_int_slider.value(),
            "bloom_radius": self.bloom_rad_slider.value(),
            "brightness": self.br_slider.value(),
            "contrast": self.ct_slider.value() / 10.0
        }
        worker.params = params
        worker.custom_cols = [self.custom_col_1, self.custom_col_2]

        pal_name = self.palette_combo.currentText().split()[0]
        mode_name = self.mode_combo.currentText().split()[0]
        suffix = f"{pal_name}_{mode_name}_{self.scale_slider.value()}x"

        for i, p in enumerate(paths):
            if dlg.wasCanceled(): break
            if self.meter: self.meter.set_message(f"Processing {p.name}...")
            QApplication.processEvents()

            try:
                original_p = self.path_map.get(p, p)
                is_gif = p.suffix.lower() == ".gif"

                if is_gif:
                    with Image.open(p) as im:
                        frames = []
                        durations = []

                        for frame in ImageSequence.Iterator(im):
                            frame = frame.convert("RGBA")
                            res = worker.apply_advanced_dither(frame)
                            frames.append(res)
                            durations.append(im.info.get('duration', 100))

                        out_name = f"{original_p.stem}_dither_{suffix}.gif"
                        save_path = out / out_name

                        frames[0].save(
                            save_path,
                            save_all=True,
                            append_images=frames[1:],
                            duration=durations,
                            loop=0
                        )

                        # If single file selected, play result
                        if len(paths) == 1:
                            self.preview_widget.set_images(p, save_path)

                else:
                    with Image.open(p) as img:
                        img = ImageOps.exif_transpose(img)
                        res = worker.apply_advanced_dither(img)
                        out_name = f"{original_p.stem}_dither_{suffix}.png"
                        res.save(out / out_name)

            except Exception as e:
                print(f"Error {p.name}: {e}")

            dlg.setValue(i+1)

        dlg.close()
        if self.meter: self.meter.set_message(None)
        QMessageBox.information(self, "Done", f"Saved to: {out}")

def create_tab(parent=None): return DitheringTab(parent)
