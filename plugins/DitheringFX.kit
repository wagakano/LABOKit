        # Page 2: Effects (Bloom)
        page_fx = QWidget(); lay_fx = QVBoxLayout(page_fx)

        lbl_bi = QLabel("Bloom Intensity:"); lbl_bi.setProperty("role", "title")
        lay_fx.addWidget(lbl_bi)
        h_bloom = QHBoxLayout()
        self.bloom_int_slider = QSlider(Qt.Horizontal); self.bloom_int_slider.setRange(0, 100); self.bloom_int_slider.setValue(0)
