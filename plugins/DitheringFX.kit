# LABOKit Plugin: Dithering FX v2.0
# ID: labokit.dithering
# Author: Kano

import os
import shutil
import random
from pathlib import Path
from PIL import Image, ImageOps, ImageFilter, ImageChops
from PySide6.QtCore import Qt, QSize, QTimer
from PySide6.QtGui import QPixmap, QFont, QColor, QImage
from PySide6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QListWidgetItem,
    QLabel, QPushButton, QFileDialog, QMessageBox, QProgressDialog,
    QFrame, QComboBox, QCheckBox, QApplication, QSlider,
    QColorDialog
)
from ui_shared import FileDropListWidget, ZoomableImageWidget, create_plus_icon

PLUGIN_ID = "labokit.dithering"
PLUGIN_NAME = "Dithering FX"
PLUGIN_VERSION = "2.1"
HELP_TEXT = (
    "<h3>Dithering FX</h3>"
    "<p>Retro dithering effects for your images.</p>"
    "<hr>"
    "<b>Features:</b>"
    "<ul>"
    "<li><b>Palettes:</b> Choose from classic console palettes or define custom colors.</li>"
    "<li><b>Algorithms:</b> Floyd-Steinberg, Bayer, Cluster, Lines, and more.</li>"
    "<li><b>Pixel Strength:</b> Adjust the 'crunchiness' of the pixels.</li>"
    "</ul>"
)

IMAGE_FILTER = "Images (*.jpg *.png *.bmp *.webp)"
CACHE_DIR = Path(os.getenv('APPDATA')) / "LABOKit" / "temp_cache"
PREVIEW_MAX_SIZE = 800 # Increased for ZoomableWidget

# --- ASSETS ---
PALETTES = {
    "1-Bit (B&W)": [0,0,0, 255,255,255],
    "GameBoy (Classic)": [15,56,15, 48,98,48, 139,172,15, 155,188,15],
    "GameBoy (Pocket)": [0,0,0, 100,100,100, 180,180,180, 255,255,255],
    "CGA (Cyan/Mag)": [0,0,0, 85,255,255, 255,85,255, 255,255,255],
    "Cyberpunk": [13,2,33, 255,0,85, 0,255,255, 255,255,0],
    "Sepia Retro": [94,75,53, 156,131,102, 214,196,177, 255,248,231],
    "Custom (User Defined)": []
}

# --- MATRICES ---
BAYER_4x4 = [[0,32,8,40],[48,16,56,24],[12,44,4,36],[60,28,52,20]]
CLUSTER_4x4 = [[24,10,12,26],[8,0,2,14],[22,6,4,16],[30,20,18,28]]
LINES_DIAG = [[10,20,30,40],[40,10,20,30],[30,40,10,20],[20,30,40,10]]
LINES_HORZ = [[0, 0, 0, 0],[32, 32, 32, 32],[48, 48, 48, 48],[16, 16, 16, 16]]
LINES_VERT = [[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16]]

class DitheringTab(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.meter = None
        self.image_paths = []
        self.path_map = {}
        self.output_dir = None
        self.current_preview_path = None

        self.preview_proxy_img = None
        self.loaded_proxy_path = ""

        self.custom_col_1 = [0, 0, 0]
        self.custom_col_2 = [255, 255, 255]

        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        self._setup_ui()

    def set_meter(self, meter):
        self.meter = meter

    def _setup_ui(self):
        outer = QVBoxLayout(self)
        outer.setContentsMargins(8, 8, 8, 8); outer.setSpacing(6)
        main_layout = QHBoxLayout(); outer.addLayout(main_layout)

        # LEFT (Controls) - Swapped to match standard layout (Left Controls, Right Preview)
        left_layout = QVBoxLayout(); main_layout.addLayout(left_layout, 1)

        lbl_list = QLabel("LOADED IMAGES:"); lbl_list.setStyleSheet("border:none; background:transparent;")
        left_layout.addWidget(lbl_list)

        self.file_list = FileDropListWidget()
        self.file_list.files_dropped.connect(self.add_dropped_files)
        self.file_list.currentItemChanged.connect(self.on_file_selected)
        left_layout.addWidget(self.file_list)

        btn_row = QHBoxLayout()
        btn_add = QPushButton("Add Images…"); btn_add.setIcon(create_plus_icon()); btn_add.clicked.connect(self.add_images)
        btn_clear = QPushButton("Clear List"); btn_clear.clicked.connect(self.clear_list)
        btn_row.addWidget(btn_add); btn_row.addWidget(btn_clear)
        left_layout.addLayout(btn_row)

        # Divider
        line = QFrame()
        line.setFrameShape(QFrame.HLine); line.setFrameShadow(QFrame.Sunken)
        line.setStyleSheet("border: none; background-color: #b3bcd1; min-height: 1px; max-height: 1px; margin: 10px 0;")
        left_layout.addWidget(line)

        # Output Folder
        l_out = QLabel("Output Folder:"); l_out.setStyleSheet("font-weight: bold; border: none; background: transparent;")
        left_layout.addWidget(l_out)
        self.output_label = QLabel("(auto)"); self.output_label.setWordWrap(True)
        self.output_label.setStyleSheet("color: #666; margin-bottom: 5px; border: none; background: transparent;")
        left_layout.addWidget(self.output_label)
        btn_change = QPushButton("Change Folder"); btn_change.clicked.connect(self.change_output_folder)
        left_layout.addWidget(btn_change)

        # Controls
        controls = QVBoxLayout(); controls.setSpacing(5)

        controls.addWidget(QLabel("Palette:", styleSheet="font-weight: bold; border: none; background: transparent;"))
        self.palette_combo = QComboBox()
        self.palette_combo.addItems(list(PALETTES.keys()))
        self.palette_combo.currentTextChanged.connect(self.on_palette_change)
        controls.addWidget(self.palette_combo)

        self.btn_pick_color = QPushButton("Pick Custom Colors")
        self.btn_pick_color.clicked.connect(self.pick_custom_colors)
        self.btn_pick_color.setVisible(False)
        controls.addWidget(self.btn_pick_color)

        controls.addWidget(QLabel("Dither Mode:", styleSheet="font-weight: bold; border: none; background: transparent;"))
        self.mode_combo = QComboBox()
        self.mode_combo.addItems([
            "Floyd-Steinberg (Diffusion)", "Bayer 4x4 (Ordered)",
            "Cluster (Newspaper)", "Lines (Diagonal)", "Lines (Horizontal)", "Lines (Vertical)", "Halftone (Dot)",
            "Noise (Random)", "None (Threshold)"
        ])
        self.mode_combo.currentTextChanged.connect(self.update_preview)
        controls.addWidget(self.mode_combo)

        controls.addWidget(QLabel("Pixel Strength:", styleSheet="font-weight: bold; border: none; background: transparent;"))
        h_slide = QHBoxLayout()
        self.scale_slider = QSlider(Qt.Horizontal); self.scale_slider.setRange(1, 16); self.scale_slider.setValue(4)
        self.scale_slider.valueChanged.connect(self.update_scale_label)
        self.scale_slider.sliderReleased.connect(self.update_preview)
        self.lbl_scale = QLabel("4x"); self.lbl_scale.setFixedWidth(30)
        h_slide.addWidget(self.scale_slider); h_slide.addWidget(self.lbl_scale)
        controls.addLayout(h_slide)

        left_layout.addLayout(controls)
        left_layout.addStretch()

        btn_sel = QPushButton("Process Selected"); btn_sel.clicked.connect(self.process_selected)
        btn_all = QPushButton("Process All"); btn_all.clicked.connect(self.process_all)
        left_layout.addWidget(btn_sel)
        left_layout.addWidget(btn_all)

        # RIGHT (Preview)
        right_layout = QVBoxLayout(); main_layout.addLayout(right_layout, 3)
        self.preview_widget = ZoomableImageWidget()
        right_layout.addWidget(self.preview_widget)

    # --- LOGIC ---

    def change_output_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Select Output Folder")
        if d:
            self.output_dir = Path(d)
            self.output_label.setText(f"{self.output_dir}")
            QMessageBox.information(self, "Success", f"Output folder changed to:\n{self.output_dir}")

    def on_palette_change(self, text):
        self.btn_pick_color.setVisible("Custom" in text)
        self.update_preview()

    def pick_custom_colors(self):
        c1 = QColorDialog.getColor(QColor(*self.custom_col_1), self, "Pick Foreground")
        if c1.isValid():
            self.custom_col_1 = [c1.red(), c1.green(), c1.blue()]
            c2 = QColorDialog.getColor(QColor(*self.custom_col_2), self, "Pick Background")
            if c2.isValid():
                self.custom_col_2 = [c2.red(), c2.green(), c2.blue()]
                self.update_preview()

    def apply_advanced_dither(self, img_pil, is_output=False):
        original_w, original_h = img_pil.size

        target_w, target_h = original_w, original_h

        if is_output:
            # Simulate preview resolution for output if desired?
            # Original code did:
            if max(original_w, original_h) > PREVIEW_MAX_SIZE:
                 ratio = min(PREVIEW_MAX_SIZE/original_w, PREVIEW_MAX_SIZE/original_h)
                 target_w = int(original_w * ratio)
                 target_h = int(original_h * ratio)
        else:
            # For preview, we are already working on a resized proxy
            pass

        scale_factor = self.scale_slider.value()
        if scale_factor > 1:
            target_w = max(1, target_w // scale_factor)
            target_h = max(1, target_h // scale_factor)

        if (target_w, target_h) != (original_w, original_h):
            img_pil = img_pil.resize((target_w, target_h), Image.Resampling.LANCZOS)

        palette_name = self.palette_combo.currentText()
        if "Custom" in palette_name:
            rgb = self.custom_col_1 + self.custom_col_2
        else:
            rgb = PALETTES.get(palette_name, PALETTES["1-Bit (B&W)"])

        full_pal = rgb + [0] * (768 - len(rgb))
        p_img = Image.new('P', (1, 1)); p_img.putpalette(full_pal)

        img_gray = img_pil.convert("L")
        mode = self.mode_combo.currentText()

        if "Floyd" in mode:
            working_img = img_pil.convert("RGB")
            result = working_img.quantize(palette=p_img, dither=Image.Dither.FLOYDSTEINBERG)
        elif "Bayer 4x4" in mode: result = self._map_pattern(img_gray, p_img, "bayer4")
        elif "Cluster" in mode: result = self._map_pattern(img_gray, p_img, "cluster")
        elif "Lines (Diagonal)" in mode: result = self._map_pattern(img_gray, p_img, "lines_d")
        elif "Lines (Horizontal)" in mode: result = self._map_pattern(img_gray, p_img, "lines_h")
        elif "Lines (Vertical)" in mode: result = self._map_pattern(img_gray, p_img, "lines_v")
        elif "Halftone" in mode: result = self._map_pattern(img_gray, p_img, "halftone")
        elif "Noise" in mode: result = self._map_pattern(img_gray, p_img, "noise")
        else:
            working_img = img_pil.convert("RGB")
            result = working_img.quantize(palette=p_img, dither=Image.Dither.NONE)

        if result.size != (original_w, original_h):
             result = result.resize((original_w, original_h), Image.Resampling.NEAREST)

        return result.convert("RGB")

    def _map_pattern(self, gray, pal_img, p_type):
        w, h = gray.size
        pat = Image.new("L", (w, h))
        data = []

        if p_type == "bayer4":
            for y in range(h):
                for x in range(w): data.append(BAYER_4x4[y%4][x%4] * 4)
        elif p_type == "cluster":
            for y in range(h):
                for x in range(w): data.append(CLUSTER_4x4[y%4][x%4] * 4)
        elif p_type == "lines_d":
            for y in range(h):
                for x in range(w): data.append(LINES_DIAG[y%4][x%4] * 4)
        elif p_type == "lines_h":
            for y in range(h):
                for x in range(w): data.append(LINES_HORZ[y%4][x%4] * 4)
        elif p_type == "lines_v":
            for y in range(h):
                for x in range(w): data.append(LINES_VERT[y%4][x%4] * 4)
        elif p_type == "halftone":
            dots = [0, 100, 100, 0, 100, 255, 255, 100, 100, 255, 255, 100, 0, 100, 100, 0]
            for y in range(h):
                for x in range(w): data.append(dots[(y%4)*4 + (x%4)])
        elif p_type == "noise":
            noise = Image.effect_noise((w, h), 40)
            return ImageChops.add(gray, ImageChops.subtract(noise, Image.new("L", (w,h), 128))).convert("RGB").quantize(palette=pal_img, dither=Image.Dither.NONE)

        if data: pat.putdata(data)
        dithered = ImageChops.add(gray, ImageChops.subtract(pat, Image.new("L", (w,h), 128)))
        return dithered.convert("RGB").quantize(palette=pal_img, dither=Image.Dither.NONE)

    def update_scale_label(self, val): self.lbl_scale.setText(f"{val}x")

    def add_dropped_files(self, files):
        self.add_files(files)

    def add_images(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Select Images", "", IMAGE_FILTER)
        if not files: return
        self.add_files([Path(f) for f in files])

    def add_files(self, paths):
        # 1. SCAN & ASK
        large_files = []
        for p in paths:
            try:
                with Image.open(p) as tmp:
                    tmp = ImageOps.exif_transpose(tmp)
                    if tmp.width > 1500 or tmp.height > 1500:
                        large_files.append(p)
            except: pass

        do_downscale = False
        if large_files:
            ans = QMessageBox.question(self, "Resolution Check",
                f"{len(large_files)} images are larger than 1500px.\n"
                "Downscaling is recommended for better effect.\n\n"
                "Auto-downscale to 1500px width?",
                QMessageBox.Yes | QMessageBox.No)
            if ans == QMessageBox.Yes: do_downscale = True

        prog = None
        if do_downscale:
            prog = QProgressDialog("Caching...", None, 0, len(paths), self)
            prog.setWindowModality(Qt.ApplicationModal); prog.show()

        for i, p in enumerate(paths):
            if do_downscale and p in large_files:
                try:
                    with Image.open(p) as img:
                        img = ImageOps.exif_transpose(img)
                        ratio = 1500 / float(img.width)
                        new_h = int(img.height * ratio)
                        img = img.resize((1500, new_h), Image.Resampling.LANCZOS)

                        cache_path = CACHE_DIR / f"{p.stem}_cached_1500px.png"
                        img.save(cache_path)

                        item = QListWidgetItem(f"{p.name} (Cached)")
                        item.setData(Qt.UserRole, cache_path)
                        self.file_list.addItem(item)
                        self.image_paths.append(cache_path)
                        self.path_map[cache_path] = p
                except Exception as e: print(e)
            else:
                item = QListWidgetItem(p.name)
                item.setData(Qt.UserRole, p)
                self.file_list.addItem(item)
                self.image_paths.append(p)
                self.path_map[p] = p

            if prog: prog.setValue(i+1)

        if prog: prog.close()
        if self.file_list.count() > 0 and self.file_list.currentRow() < 0:
            self.file_list.setCurrentRow(0)

    def clear_list(self):
        self.image_paths.clear(); self.file_list.clear(); self.path_map.clear()
        self.preview_proxy_img = None; self.loaded_proxy_path = ""
        self.preview_widget.set_image_pixmaps(None, None)
        try:
            for f in CACHE_DIR.glob("*"):
                try: os.remove(f)
                except: pass
        except: pass

    def on_file_selected(self, item):
        if not item: return
        real_path = item.data(Qt.UserRole)

        if real_path and str(real_path) != self.loaded_proxy_path:
            self.current_preview_path = real_path
            try:
                temp_img = Image.open(real_path)
                temp_img = ImageOps.exif_transpose(temp_img)
                full_img = temp_img.convert("RGBA")

                # Create a proxy for display
                MAX_P = PREVIEW_MAX_SIZE
                w, h = full_img.size
                if max(w, h) > MAX_P:
                    ratio = min(MAX_P/w, MAX_P/h)
                    self.preview_proxy_img = full_img.resize((int(w*ratio), int(h*ratio)), Image.Resampling.BOX)
                else:
                    self.preview_proxy_img = full_img.copy()

                self.loaded_proxy_path = str(real_path)

                self.update_preview()
            except Exception as e:
                print(f"Load Error: {e}")

    def update_preview(self):
        if not self.preview_proxy_img: return

        if self.meter: self.meter.set_message("Previewing Dither...")
        QApplication.setOverrideCursor(Qt.WaitCursor)

        try:
            # 1. Prepare Original Pixmap
            raw_orig = self.preview_proxy_img.tobytes("raw", "RGBA")
            qorig = QImage(raw_orig, self.preview_proxy_img.width, self.preview_proxy_img.height, QImage.Format_RGBA8888)
            pix_orig = QPixmap.fromImage(qorig)

            # 2. Process Dithering on Proxy
            work_img = self.preview_proxy_img.copy()
            res = self.apply_advanced_dither(work_img, is_output=False)

            display_img = res.convert("RGBA")
            data = display_img.tobytes("raw", "RGBA")
            qim = QImage(data, display_img.width, display_img.height, QImage.Format_RGBA8888)
            pix_res = QPixmap.fromImage(qim)

            self.preview_widget.set_image_pixmaps(pix_orig, pix_res, preserve_zoom=True)

        except Exception as e: print(e)
        finally:
            QApplication.restoreOverrideCursor()
            if self.meter: self.meter.set_message(None)

    def ensure_output_dir(self, sample):
        if not self.output_dir:
            original_source = self.path_map.get(sample, sample)
            self.output_dir = original_source.parent / "LABOKit_Dither"
            self.output_dir.mkdir(exist_ok=True)
            self.output_label.setText(f"{self.output_dir}")
        return self.output_dir

    def process_selected(self):
        sel = self.file_list.selectedItems()
        if sel:
            targets = [i.data(Qt.UserRole) for i in sel]
            self._run_process(targets)

    def process_all(self):
        targets = [self.file_list.item(i).data(Qt.UserRole) for i in range(self.file_list.count())]
        self._run_process(targets)

    def _run_process(self, paths):
        if not paths: return
        out = self.ensure_output_dir(paths[0])
        dlg = QProgressDialog("Processing...", "Cancel", 0, len(paths), self)
        dlg.setWindowModality(Qt.ApplicationModal); dlg.show()

        pal = self.palette_combo.currentText().split()[0]
        mode = self.mode_combo.currentText().split()[0]
        suffix = f"{pal}_{mode}_{self.scale_slider.value()}x"

        for i, p in enumerate(paths):
            if dlg.wasCanceled(): break
            if self.meter: self.meter.set_message(f"Processing {p.name}...")
            try:
                with Image.open(p) as img:
                    img = ImageOps.exif_transpose(img)
                    res = self.apply_advanced_dither(img, is_output=True)

                    original_p = self.path_map.get(p, p)
                    out_name = f"{original_p.stem}_dither_{suffix}.png"
                    res.save(out / out_name)
            except: pass
            dlg.setValue(i+1)
        dlg.close()
        if self.meter: self.meter.set_message(None)
        QMessageBox.information(self, "Done", f"Saved to: {out}")

def create_tab(parent=None): return DitheringTab(parent)
