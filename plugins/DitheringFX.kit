QSlider::handle:horizontal { background: #ff9900; border: 1px solid #ff9900; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; }
#PreviewBox { background-color: #000000; border: 1px dashed #444; border-radius: 6px; }
