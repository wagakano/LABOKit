        self.preview_proxy_img = None
        self.loaded_proxy_path = ""

        self.custom_col_1 = [0, 0, 0]
        self.custom_col_2 = [255, 255, 255]

        # Threading
        self.preview_worker = PreviewWorker()
        self.preview_worker.finished.connect(self.on_preview_ready)

        # Debounce
        self.debounce_timer = QTimer()
        self.debounce_timer.setSingleShot(True)
        self.debounce_timer.setInterval(200)
        self.debounce_timer.timeout.connect(self.start_preview_worker)

        # UI Styling (Light Mode & Bold Titles)
        self.content_frame = QFrame(self)
        self.content_frame.setObjectName("DitheringContent")
        self.content_frame.setStyleSheet("""
            #DitheringContent { background: transparent; }
            #DitheringContent QLabel { color: #1c2333; }

            /* Clean Bold Labels */
            #DitheringContent QLabel[role="title"] { font-weight: bold; border: none; background: transparent; }

            #DitheringContent QToolBox QWidget {
                background-color: #f7f9fc;
                border-radius: 4px;
            }
            #DitheringContent QToolBox::tab {
                color: #1c2333; font-weight: bold; background-color: #e1e6f0;
                border: 1px solid #b3bcd1; border-radius: 4px;
            }
            #DitheringContent QToolBox::tab:selected { background-color: #d4e3fc; font-style: italic; }
        """)

        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        self._setup_ui()

    def set_meter(self, meter):
        self.meter = meter

