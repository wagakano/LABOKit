    "Custom (User Defined)": []
}

# --- MATRICES ---
BAYER_4x4 = [[0,32,8,40],[48,16,56,24],[12,44,4,36],[60,28,52,20]]
LINES_DIAG = [[10,20,30,40],[40,10,20,30],[30,40,10,20],[20,30,40,10]]
LINES_HORZ = [[0, 0, 0, 0],[32, 32, 32, 32],[48, 48, 48, 48],[16, 16, 16, 16]]
LINES_VERT = [[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16]]

# For Atkinson/Stucki etc, we will use Ordered Dither approximations for performance in Python preview.
# True error diffusion is too slow in python loops for realtime preview.
# These patterns simulate the look roughly.
ATKINSON_MAP = [[0, 128, 32, 160], [192, 64, 224, 96], [48, 176, 16, 144], [240, 112, 208, 80]] # Approx pattern

# --- WORKER FOR PREVIEW ---
class PreviewWorker(QThread):
    finished = Signal(object)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.img_proxy = None
        self.params = {}
        self.custom_cols = None

    def set_data(self, img_proxy, params, custom_cols):
        self.img_proxy = img_proxy
        self.params = params
        self.custom_cols = custom_cols

    def run(self):
        if not self.img_proxy:
            self.finished.emit(None)
            return

        try:
            work_img = self.img_proxy.copy()
            res = self.apply_advanced_dither(work_img)

            display_img = res.convert("RGBA")
            data = display_img.tobytes("raw", "RGBA")
            qim = QImage(data, display_img.width, display_img.height, QImage.Format_RGBA8888)
            pix_res = QPixmap.fromImage(qim)

            self.finished.emit(pix_res)
        except Exception as e:
            print(f"Preview Error: {e}")
            self.finished.emit(None)

    def apply_advanced_dither(self, img_pil):
        # 1. Resize Down
        original_w, original_h = img_pil.size
        scale_factor = self.params.get("scale", 1)
        target_w, target_h = original_w, original_h

        if scale_factor > 1:
            target_w = max(1, target_w // scale_factor)
            target_h = max(1, target_h // scale_factor)
            img_pil = img_pil.resize((target_w, target_h), Image.Resampling.LANCZOS)

        # 2. Pre-Process (Brightness/Contrast)
        bright = self.params.get("brightness", 0)
        contrast = self.params.get("contrast", 1.0)

        if bright != 0:
            # 0.0 is original, we map -50..50 to roughly 0.5..1.5 factor or add offset?
            # ImageEnhance.Brightness uses factor (1.0 = original).
            # Lets map slider -50..50 to 0.5..1.5
            factor = 1.0 + (bright / 100.0)
            img_pil = ImageEnhance.Brightness(img_pil).enhance(factor)

        if contrast != 1.0:
            img_pil = ImageEnhance.Contrast(img_pil).enhance(contrast)

        # 3. Dither
        palette_name = self.params.get("palette", "1-Bit (B&W)")
        if "Custom" in palette_name and self.custom_cols:
            rgb = self.custom_cols[0] + self.custom_cols[1]
        else:
            rgb = PALETTES.get(palette_name, PALETTES["1-Bit (B&W)"])

        # Create palette image
        full_pal = rgb + [0] * (768 - len(rgb))
        p_img = Image.new('P', (1, 1)); p_img.putpalette(full_pal)

        img_gray = img_pil.convert("L")
        mode = self.params.get("mode", "Floyd")

        if "Floyd" in mode:
            working_img = img_pil.convert("RGB")
            dithered = working_img.quantize(palette=p_img, dither=Image.Dither.FLOYDSTEINBERG)
        elif "Bayer" in mode: dithered = self._map_pattern(img_gray, p_img, "bayer4")
        elif "Lines (Diagonal)" in mode: dithered = self._map_pattern(img_gray, p_img, "lines_d")
        elif "Lines (Horizontal)" in mode: dithered = self._map_pattern(img_gray, p_img, "lines_h")
        elif "Lines (Vertical)" in mode: dithered = self._map_pattern(img_gray, p_img, "lines_v")
        elif "Halftone" in mode: dithered = self._map_pattern(img_gray, p_img, "halftone")
        elif "Noise" in mode: dithered = self._map_pattern(img_gray, p_img, "noise")
        elif "Atkinson" in mode: dithered = self._map_pattern(img_gray, p_img, "atkinson") # Approx
        elif "Stucki" in mode: dithered = self._map_pattern(img_gray, p_img, "atkinson") # Approx
        elif "Sierra" in mode: dithered = self._map_pattern(img_gray, p_img, "atkinson") # Approx
        elif "Burkes" in mode: dithered = self._map_pattern(img_gray, p_img, "atkinson") # Approx
        else:
            working_img = img_pil.convert("RGB")
            dithered = working_img.quantize(palette=p_img, dither=Image.Dither.NONE)

        # 4. Bloom (Post-Dither)
        bloom_int = self.params.get("bloom_intensity", 0)
        bloom_rad = self.params.get("bloom_radius", 0)

        result = dithered.convert("RGB")

        if bloom_int > 0:
            glow = result.filter(ImageFilter.GaussianBlur(bloom_rad))
            glow = ImageEnhance.Brightness(glow).enhance(bloom_int / 50.0)
            result = ImageChops.add(result, glow)

        # 5. Restore Size
        if result.size != (original_w, original_h):
             result = result.resize((original_w, original_h), Image.Resampling.NEAREST)

        return result

    def _map_pattern(self, gray, pal_img, p_type):
        w, h = gray.size
        pat = Image.new("L", (w, h))
        data = []

        if p_type == "bayer4":
            for y in range(h):
                for x in range(w): data.append(BAYER_4x4[y%4][x%4] * 4)
        elif p_type == "lines_d":
            for y in range(h):
                for x in range(w): data.append(LINES_DIAG[y%4][x%4] * 4)
        elif p_type == "lines_h":
            for y in range(h):
                for x in range(w): data.append(LINES_HORZ[y%4][x%4] * 4)
        elif p_type == "lines_v":
            for y in range(h):
                for x in range(w): data.append(LINES_VERT[y%4][x%4] * 4)
        elif p_type == "halftone":
            dots = [0, 100, 100, 0, 100, 255, 255, 100, 100, 255, 255, 100, 0, 100, 100, 0]
            for y in range(h):
                for x in range(w): data.append(dots[(y%4)*4 + (x%4)])
        elif p_type == "atkinson":
            # Using Bayer as placeholder for approximation in fast python mode
            # Ideally this would be error diffusion but it's too slow in python loops.
            for y in range(h):
                for x in range(w): data.append(ATKINSON_MAP[y%4][x%4])
        elif p_type == "noise":
            noise = Image.effect_noise((w, h), 40)
            return ImageChops.add(gray, ImageChops.subtract(noise, Image.new("L", (w,h), 128))).convert("RGB").quantize(palette=pal_img, dither=Image.Dither.NONE)

        if data: pat.putdata(data)
        dithered = ImageChops.add(gray, ImageChops.subtract(pat, Image.new("L", (w,h), 128)))
        return dithered.convert("RGB").quantize(palette=pal_img, dither=Image.Dither.NONE)

class DitheringTab(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.meter = None
        self.image_paths = []
        self.path_map = {}
        self.output_dir = None
        self.current_preview_path = None

        self.preview_proxy_img = None
