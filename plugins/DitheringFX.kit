    QWidget, QVBoxLayout, QHBoxLayout, QListWidget, QListWidgetItem,
    QLabel, QPushButton, QFileDialog, QMessageBox, QProgressDialog,
    QFrame, QComboBox, QCheckBox, QApplication, QSlider,
    QColorDialog
)

PLUGIN_ID = "labokit.dithering"
PLUGIN_NAME = "Dithering FX"
PLUGIN_VERSION = "2.0"
HELP_TEXT = (
    "Dithering FX v2.0\n\n"
    "1. Improved Dithering result, adding more options and custom color choices.\n"
    "2. Now you can generate multiple outputs from the same image.\n"
    "3. Downscaling feature to make the effect stronger & consistent on high-res images.\n"
    "4. Fixed change output folder, now you can do custom output folder.\n"
    "5. Optimized Live Preview."
)

IMAGE_FILTER = "Images (*.jpg *.png *.bmp *.webp)"
CACHE_DIR = Path(os.getenv('APPDATA')) / "LABOKit" / "temp_cache"
PREVIEW_MAX_SIZE = 500

# --- ASSETS ---
RUNNING_VALUES = [
    "0.000000α", "0.134891α", "0.210317α", "0.337187α",
    "0.456903α", "0.571024α", "0.571082α", "1.048596β",
    "1.130205β", "1.130426β", "2.615483β", "3.019430δ",
    "3.372329δ", "4.456441ε"
]

PALETTES = {
    "1-Bit (B&W)": [0,0,0, 255,255,255],
    "GameBoy (Classic)": [15,56,15, 48,98,48, 139,172,15, 155,188,15],
    "GameBoy (Pocket)": [0,0,0, 100,100,100, 180,180,180, 255,255,255],
    "CGA (Cyan/Mag)": [0,0,0, 85,255,255, 255,85,255, 255,255,255],
    "Cyberpunk": [13,2,33, 255,0,85, 0,255,255, 255,255,0],
    "Sepia Retro": [94,75,53, 156,131,102, 214,196,177, 255,248,231],
    "Custom (User Defined)": []
}

# --- MATRICES ---
BAYER_4x4 = [[0,32,8,40],[48,16,56,24],[12,44,4,36],[60,28,52,20]]
CLUSTER_4x4 = [[24,10,12,26],[8,0,2,14],[22,6,4,16],[30,20,18,28]]
LINES_DIAG = [[10,20,30,40],[40,10,20,30],[30,40,10,20],[20,30,40,10]]
LINES_HORZ = [[0, 0, 0, 0],[32, 32, 32, 32],[48, 48, 48, 48],[16, 16, 16, 16]]
LINES_VERT = [[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16],[0, 32, 48, 16]]

DARK_STYLE = """
QWidget { background-color: #121212; color: #e0e0e0; font-family: 'Segoe UI', sans-serif; }
QFrame { background-color: #121212; border: none; }
QListWidget { background-color: #1e1e1e; border: 1px solid #333; border-radius: 4px; color: #cc8800; }
