        self.btn_pick_color = QPushButton("Pick Custom Colors")
        self.btn_pick_color.clicked.connect(self.pick_custom_colors)
        self.btn_pick_color.setVisible(False)
        lay_dither.addWidget(self.btn_pick_color)

        lbl_mode = QLabel("Dither Mode:"); lbl_mode.setProperty("role", "title")
        lay_dither.addWidget(lbl_mode)
        self.mode_combo = QComboBox()
        self.mode_combo.addItems([
            "Floyd-Steinberg (Diffusion)", "Bayer 4x4 (Ordered)",
            "Cluster (Newspaper)", "Lines (Diagonal)", "Lines (Horizontal)", "Lines (Vertical)", "Halftone (Dot)",
