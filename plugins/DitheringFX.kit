    "Apple II": [0,0,0, 64,51,83, 114,38,64, 194,77,220, 20,68,36, 81,114,121, 122,106,97, 192,162,185, 46,72,0, 107,117,80, 153,102,0, 227,159,85, 68,140,43, 122,192,129, 172,217,99, 255,255,255],
