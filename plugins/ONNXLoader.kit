# LABOKit Plugin: ONNXLoader
# ID: labokit.onnx
# Author: Kano

import os
import cv2
import numpy as np
import random
from pathlib import Path
from PySide6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QPushButton, QLabel,
    QFileDialog, QMessageBox, QFrame, QProgressDialog, QListWidget,
    QListWidgetItem, QApplication
)
from PySide6.QtCore import Qt, QThread, Signal, QTimer, QSize
from PySide6.QtGui import QPixmap, QFont

PLUGIN_NAME = "ONNX Loader"
HELP_TEXT = "Load your own .onnx upscaler models directly!"
PLUGIN_VERSION = "1.0"

# --- CONSTANTS & STYLING ---
IMAGE_FILTER = "Images (*.png *.jpg *.jpeg *.webp *.bmp)"

RUNNING_VALUES = [
    "0.000000α", "0.134891α", "0.210317α", "0.337187α",
    "0.456903α", "0.571024α", "0.571082α", "1.048596β",
    "1.130205β", "1.130426β", "2.615483β", "3.019430δ",
    "3.372329δ", "4.456441ε"
]

# --- WORKER THREAD ---
class OnnxWorker(QThread):
    finished = Signal(object, object) # Msg, Error
    progress = Signal(int)

    def __init__(self, model_path, image_paths, output_dir):
        super().__init__()
        self.model_path = model_path
        self.image_paths = image_paths
        self.output_dir = output_dir

    def run(self):
        try:
            import onnxruntime as ort
        except ImportError:
            self.finished.emit(None, "Library 'onnxruntime' is missing.\nPlease install it: pip install onnxruntime")
            return

        try:
            session = ort.InferenceSession(self.model_path, providers=['CPUExecutionProvider'])
            input_name = session.get_inputs()[0].name

            count = 0
            for img_path in self.image_paths:
                img = cv2.imread(str(img_path), cv2.IMREAD_UNCHANGED).astype(np.float32) / 255.0

                # Ubah urutan channel dari HWC (Height,Width,Channel) ke CHW (Channel,Height,Width)
                img = np.transpose(img, (2, 0, 1))
                img = np.expand_dims(img, 0) # Tambah batch dimension

                # 3. Inference
                output = session.run(None, {input_name: img})[0]

                # 4. Post-process
                output = np.squeeze(output) # Hapus batch dimension
                output = np.transpose(output, (1, 2, 0)) # Balikin ke HWC
                output = np.clip(output * 255.0, 0, 255).astype(np.uint8) # Denormalize

                # 5. Save
                save_path = self.output_dir / f"{img_path.stem}_custom.png"
                cv2.imwrite(str(save_path), output)

                count += 1
                self.progress.emit(count)

            self.finished.emit(f"Processed {count} images.", None)

        except Exception as e:
            self.finished.emit(None, str(e))

# --- UI TAB ---
class CustomOnnxTab(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.model_path = None
        self.image_paths = []
        self.output_dir = None
        self.output_map = {} # Mapping input path -> output path

        # UI Elements for Animation
        self.pixel_labels = []
        self._running_index = 0

        self._setup_ui()
        self._init_running_text()

    def _setup_ui(self):
        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(8, 8, 8, 8)
        outer_layout.setSpacing(6)

        # Main Horizontal Layout (Split Left & Right)
        main_layout = QHBoxLayout()
        outer_layout.addLayout(main_layout, stretch=1)

        # --- LEFT PANEL (File List) ---
        left_layout = QVBoxLayout()
        main_layout.addLayout(left_layout, stretch=1)

        lbl_list = QLabel("LOADED IMAGES (ONNX):")
        lbl_list.setStyleSheet("border: none; background: transparent; color: #1c2333;")
        left_layout.addWidget(lbl_list)

        self.file_list = QListWidget()
        self.file_list.currentItemChanged.connect(self.on_file_selected)
        left_layout.addWidget(self.file_list)

        btn_row = QHBoxLayout()
        btn_add = QPushButton("Add Images…")
        btn_add.clicked.connect(self.add_images)
        btn_clear = QPushButton("Clear List")
        btn_clear.clicked.connect(self.clear_list)
        btn_row.addWidget(btn_add)
        btn_row.addWidget(btn_clear)
        left_layout.addLayout(btn_row)

        # --- RIGHT PANEL (Controls & Preview) ---
        right_layout = QVBoxLayout()
        main_layout.addLayout(right_layout, stretch=3)

        self.output_label = QLabel("OUTPUT FOLDER: (auto)")
        self.output_label.setWordWrap(True)
        right_layout.addWidget(self.output_label)

        # 1. Model Selector Box (Styled like a control panel)
        model_box = QFrame()
        model_box.setStyleSheet("background: #e1e6f0; border-radius: 5px; padding: 6px;")
        mbox_lay = QVBoxLayout(model_box)

        mbox_lay.addWidget(QLabel("<b>Active Model:</b>"))

        h_mod = QHBoxLayout()
        self.lbl_model = QLabel("No model selected (.onnx)")
        self.lbl_model.setStyleSheet("color: #555;")
        btn_mod = QPushButton("Browse...")
        btn_mod.setFixedWidth(80)
        btn_mod.clicked.connect(self.browse_model)

        h_mod.addWidget(self.lbl_model)
        h_mod.addWidget(btn_mod)
        mbox_lay.addLayout(h_mod)
        right_layout.addWidget(model_box)

        # 2. Preview Area
        preview_layout = QHBoxLayout()
        self.orig_frame = self._create_preview_box("Original")
        self.res_frame = self._create_preview_box("Result (Upscaled)")
        preview_layout.addWidget(self.orig_frame)
        preview_layout.addWidget(self.res_frame)
        right_layout.addLayout(preview_layout, stretch=1)

        # 3. Action Buttons
        right_layout.addSpacing(10)
        action_row = QHBoxLayout()
        btn_sel = QPushButton("Upscale (Selected)")
        btn_sel.clicked.connect(self.process_selected)
        btn_all = QPushButton("Upscale (All)")
        btn_all.clicked.connect(self.process_all)

        action_row.addWidget(btn_sel, stretch=1)
        action_row.addWidget(btn_all, stretch=1)
        right_layout.addLayout(action_row)

        # --- FOOTER (Pixel Bar) ---
        bottom_frame = QFrame()
        bottom_frame.setObjectName("PixelBar")
        bar_layout = QHBoxLayout(bottom_frame)
        bar_layout.setContentsMargins(10, 3, 10, 4)
        bar_layout.setSpacing(18)

        pixel_font = QFont("Consolas", 9)
        for _ in range(10):
            lbl = QLabel("0.000000α")
            lbl.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            lbl.setFont(pixel_font)
            self.pixel_labels.append(lbl)
            bar_layout.addWidget(lbl)

        outer_layout.addWidget(bottom_frame)

    def change_output_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Select Output Folder")
        if d:
            self.output_dir = Path(d)
            self.output_label.setText(f"OUTPUT: {self.output_dir}")
            QMessageBox.information(self, "Success", f"Output folder changed to:\n{self.output_dir}")

    # --- UI HELPERS ---
    def _create_preview_box(self, title):
        frame = QFrame()
        frame.setFrameShape(QFrame.StyledPanel)
        layout = QVBoxLayout(frame)
        layout.setContentsMargins(6, 6, 6, 6)

        lbl_title = QLabel(title)
        lbl_title.setStyleSheet("border: none; background: transparent; color: #1c2333;")
        layout.addWidget(lbl_title)

        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setFrameShadow(QFrame.Sunken)
        line.setStyleSheet("border: none; border-top: 1px solid #dbe2f2; margin-bottom: 2px;")
        layout.addWidget(line)

        img_lbl = QLabel()
        img_lbl.setAlignment(Qt.AlignCenter)
        img_lbl.setMinimumSize(QSize(200, 200))
        img_lbl.setStyleSheet("border: none; background: transparent;")
        layout.addWidget(img_lbl, stretch=1)

        frame.img_lbl = img_lbl # Save reference
        return frame

    def _init_running_text(self):
        for lbl in self.pixel_labels:
            lbl.setText(self._random_running_value() + "  •")
        self._running_index = 0
        self._running_timer = QTimer(self)
        self._running_timer.setInterval(1000)
        self._running_timer.timeout.connect(self._update_running_bar)
        self._running_timer.start()

    def _random_running_value(self):
        return random.choice(RUNNING_VALUES)

    def _update_running_bar(self):
        if not self.pixel_labels: return
        idx = self._running_index % len(self.pixel_labels)
        self._running_index += 1
        self.pixel_labels[idx].setText(self._random_running_value() + "  •")

    # --- LOGIC ---
    def browse_model(self):
        f, _ = QFileDialog.getOpenFileName(self, "Select ONNX Model", "", "ONNX Model (*.onnx)")
        if f:
            self.model_path = f
            self.lbl_model.setText(Path(f).name)

    def add_images(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Select Images", "", IMAGE_FILTER)
        if not files: return
        for f in files:
            path = Path(f)
            if path not in self.image_paths:
                self.image_paths.append(path)
                item = QListWidgetItem(path.name)
                item.setData(Qt.UserRole, path)
                self.file_list.addItem(item)
        if self.file_list.count() > 0: self.file_list.setCurrentRow(0)

    def clear_list(self):
        self.image_paths.clear()
        self.file_list.clear()
        self.output_map.clear()
        self._update_preview(None)

    def on_file_selected(self, item, prev):
        if not item:
            self._update_preview(None)
        else:
            path = item.data(Qt.UserRole)
            self._update_preview(path)

    def _update_preview(self, path):
        orig, res = self.orig_frame.img_lbl, self.res_frame.img_lbl

        if not path:
            orig.setPixmap(QPixmap())
            orig.setText("(no image)")
            res.setPixmap(QPixmap())
            res.setText("(no result)")
            return

        # Show Original
        pix = QPixmap(str(path))
        if not pix.isNull():
            orig.setPixmap(pix.scaled(orig.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation))
            orig.setText("")
        else:
            orig.setText("(error)")

        # Show Result (if exists)
        out_path = self.output_map.get(path)
        if out_path and out_path.exists():
            rpix = QPixmap(str(out_path))
            res.setPixmap(rpix.scaled(res.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation))
            res.setText("")
        else:
            res.setPixmap(QPixmap())
            res.setText("(run upscale to see result)")

    def ensure_output_dir(self, sample):
        if not self.output_dir:
            self.output_dir = sample.parent / "LABOKit_CustomONNX"
            self.output_dir.mkdir(exist_ok=True)
            self.output_label.setText(f"OUTPUT FOLDER: {self.output_dir}")
        return self.output_dir

    def process_selected(self):
        sel = self.file_list.selectedItems()
        if not sel: return QMessageBox.warning(self, "Info", "Select images first.")
        targets = [item.data(Qt.UserRole) for item in sel]
        self._run_process(targets)

    def process_all(self):
        if not self.image_paths: return QMessageBox.warning(self, "Info", "Add images first.")
        self._run_process(self.image_paths)

    def _run_process(self, paths):
        if not self.model_path:
            return QMessageBox.warning(self, "Error", "Please select an .onnx model first!")

        out_dir = self.ensure_output_dir(paths[0])

        # UI Progress
        self.dlg = QProgressDialog("Running ONNX Inference...", "Cancel", 0, len(paths), self)
        self.dlg.setWindowModality(Qt.ApplicationModal)
        self.dlg.show()

        # Threading
        self.worker = OnnxWorker(self.model_path, paths, out_dir)
        self.worker.progress.connect(self.dlg.setValue)
        self.worker.finished.connect(lambda msg, err: self.on_finished(msg, err, paths))
        self.worker.start()

    def on_finished(self, msg, error, processed_paths):
        self.dlg.close()
        if error:
            QMessageBox.critical(self, "Error", f"Upscale Failed:\n{error}")
        else:
            # Update output map so preview works
            for p in processed_paths:
                self.output_map[p] = self.output_dir / f"{p.stem}_custom.png"

            # Refresh current preview
            curr = self.file_list.currentItem()
            if curr: self.on_file_selected(curr, None)

            QMessageBox.information(self, "Success", f"{msg}")

def create_tab(parent):
    return CustomOnnxTab(parent)