class StickerWorker(QThread):
    progress = Signal(int, str)
    finished = Signal(int)
    error = Signal(str)
    preview_ready = Signal(QPixmap) # For preview mode

    def __init__(self, paths, out_dir, params, mode="process", parent=None):
        super().__init__(parent)
        self.paths = paths
        self.out_dir = out_dir
        self.params = params
        self.mode = mode # "process" or "preview"
        self.is_running = True

    def run(self):
        try:
            if self.mode == "preview":
                self.run_preview()
            else:
                self.run_batch()
        except Exception as e:
            self.error.emit(str(e))

    def run_preview(self):
        if not self.paths: return
        p = self.paths[0]
        try:
            # Force PDF param false for preview to always get Raster
            # Ideally we might want to preview vectors, but standard widget is raster
            # So we create a raster representation even if PDF mode selected for output

            # Temporarily force PDF off for preview rendering logic or handle tuple
            is_pdf_req = self.params.get('pdf', False)
            self.params['pdf'] = False # Force raster for preview
            final_img = self.process_image(p)
            self.params['pdf'] = is_pdf_req # Restore

            if final_img:
                # Convert PIL to QPixmap
                # PIL RGBA -> QImage
                data = final_img.convert("RGBA").tobytes("raw", "RGBA")
                qim = QImage(data, final_img.width, final_img.height, QImage.Format_RGBA8888)
                # Create a deep copy to ensure data persistence
                pix = QPixmap.fromImage(qim.copy())
                self.preview_ready.emit(pix)
        except Exception as e:
            # print(f"Preview Error: {e}")
            self.error.emit(str(e))

    def run_batch(self):
        cnt = 0
        total = len(self.paths)
        is_pdf = self.params.get('pdf', False)

        for i, p in enumerate(self.paths):
            if not self.is_running: break
            self.progress.emit(i, f"Processing {p.name}...")

            try:
                res = self.process_image(p)
                if res:
                    if is_pdf and isinstance(res, tuple):
                        # PDF Mode
                        final_comp, contours, crop_box, orig_size = res
                        out_path = self.out_dir / f"{p.stem}_sticker.pdf"
                        self.save_as_pdf(final_comp, contours, crop_box, orig_size, out_path)
                    else:
                        # PNG Mode
                        out_path = self.out_dir / f"{p.stem}_sticker.png"
                        res.save(out_path)
                    cnt += 1
            except Exception as e:
                print(f"Error processing {p.name}: {e}")
                import traceback; traceback.print_exc()

        self.finished.emit(cnt)

    def save_as_pdf(self, image_pil, contours, crop_box, orig_size, out_path):
        if not HAS_REPORTLAB:
            raise ImportError("ReportLab is not installed. PDF output unavailable.")

        # crop_box is (left, top, right, bottom) in global coords of orig_padded
        # orig_size is (height, width) of orig_padded

        # 1. Setup Canvas
        # Page size = Image size (in points)
        # 72 DPI for PDF points vs 300 DPI or whatever for Image?
        # Let's map 1 pixel = 1 point for simplicity, or scale?
        # Print workflows often assume 300 DPI.
        # If we want physical size match:
        # width_inch = px / 300
        # width_pts = width_inch * 72 = px * 72/300 = px * 0.24

        dpi = 300.0
        scale = 72.0 / dpi

        w_px, h_px = image_pil.size
        w_pts, h_pts = w_px * scale, h_px * scale

        c = canvas.Canvas(str(out_path), pagesize=(w_pts, h_pts))

        # 2. Draw Raster Image
        # ReportLab draws images from bottom-up or top-down?
        # drawImage(image, x, y, width=None, height=None, mask=None)
        # origin (0,0) is bottom-left usually.
        # But image logic is top-left.

        # Save PIL to temp buffer for ReportLab
        import tempfile
        with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tf:
            image_pil.save(tf, format='PNG')
            tf.close()
            # Draw image filling the page
            c.drawImage(tf.name, 0, 0, width=w_pts, height=h_pts, mask='auto')
            os.unlink(tf.name)

        # 3. Draw Vectors
        # Contours are in pixels relative to orig_padded (before crop)
        # Need to adjust for Crop
        crop_x, crop_y = 0, 0
        if crop_box:
            crop_x, crop_y = crop_box[0], crop_box[1] # left, top

        stroke_c = self.params.get('stroke_c', (255, 0, 255))
        stroke_w = self.params.get('stroke_w', 2)

        # Set stroke
        r, g, b = stroke_c
        c.setStrokeColorRGB(r/255.0, g/255.0, b/255.0)
        c.setLineWidth(stroke_w * scale) # Scale stroke width too?

        # CV2 Contours: List of arrays [x, y]
        # Coordinate system flip: PDF (0,0) is bottom-left. Image (0,0) is top-left.
        # y_pdf = h_pts - (y_img * scale)
        # Chaikin's Corner Cutting Algorithm
        def chaikin_smooth(points, iterations=3):
            if len(points) < 3: return points

            for _ in range(iterations):
                new_points = []
                # Close the loop: append start point at end
                # But points are distinct.
                # Assuming closed contour (sticker cut)
                pts_closed = points + [points[0]]

                for i in range(len(pts_closed) - 1):
                    p0 = pts_closed[i]
                    p1 = pts_closed[i+1]

                    # Q = 0.75 P0 + 0.25 P1
                    Q = (0.75 * p0[0] + 0.25 * p1[0], 0.75 * p0[1] + 0.25 * p1[1])
                    # R = 0.25 P0 + 0.75 P1
                    R = (0.25 * p0[0] + 0.75 * p1[0], 0.25 * p0[1] + 0.75 * p1[1])

                    new_points.append(Q)
                    new_points.append(R)

                points = new_points
            return points

        for cnt in contours:
            # cnt is shape (N, 1, 2) -> Convert to list of (x,y)
            raw_points = [(pt[0], pt[1]) for pt in cnt[:, 0, :]]

            # Apply Smoothing
            smoothed_points = chaikin_smooth(raw_points, iterations=3)

            path = c.beginPath()

            first = True
            for x_global, y_global in smoothed_points:
                # Adjust for crop
                x_rel = x_global - crop_x
                y_rel = y_global - crop_y

                # Scale to points
                x_pdf = x_rel * scale
                # Flip Y
                y_pdf = h_pts - (y_rel * scale)

                if first:
                    path.moveTo(x_pdf, y_pdf)
                    first = False
                else:
                    path.lineTo(x_pdf, y_pdf)

            path.close()
            c.drawPath(path, stroke=1, fill=0)

        c.save()

    def process_image(self, path):
        # 1. Load Image
        orig = Image.open(path).convert("RGBA")

        # 2. Extract Alpha & Dilate (White Body)
        # Convert to numpy for CV2 (PIL is RGB/RGBA, cv2 expects array)
        img_np = np.array(orig)
        alpha = img_np[:, :, 3]

        border_px = self.params.get('border', 30)
        border_color = self.params.get('border_c', (0, 0, 0)) # Default Black
        offset_px = self.params.get('offset', 0)
        stroke_px = self.params.get('stroke_w', 2)
        stroke_color = self.params.get('stroke_c', (255, 0, 255))

        # Pre-Smoothing Source Alpha (Optional)
        # Allows softening jagged pixel art edges before generating the cut line
        smooth_source = self.params.get('smooth_source', False)
        blur_strength = self.params.get('blur_strength', 3)

        def get_kernel(size):
            k_size = 2 * int(size) + 1
            return cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k_size, k_size))

        # Pad image to accommodate dilation
        # Padding = Max Expansion + Stroke + Safety
        # Max Expansion = max(Border, Border + Offset) if Offset > 0 else Border
        # Let's be generous
        pad = int(border_px + abs(offset_px) + stroke_px + 30)
        orig_padded = ImageOps.expand(orig, border=pad, fill=(0,0,0,0))
        img_np_padded = np.array(orig_padded)
        alpha_padded = img_np_padded[:, :, 3]

        # Pre-Blur Source Alpha if requested
        if smooth_source and blur_strength > 0:
            k = 2 * blur_strength + 1
            alpha_blurred = cv2.GaussianBlur(alpha_padded, (k, k), 0)
            # Threshold back to binary to "round off" the steps
            _, alpha_processed = cv2.threshold(alpha_blurred, 127, 255, cv2.THRESH_BINARY)
        else:
            alpha_processed = alpha_padded.copy()

        # 1. BORDER MASK (BLEED)
        # Dilate Processed Alpha
        border_mask = alpha_processed.copy()
        if border_px > 0:
            kernel_b = get_kernel(border_px)
            border_mask = cv2.dilate(border_mask, kernel_b)

        # 2. CUT LINE MASK
        # Calculated independently from Original Alpha
        # Total Expansion = Border + Offset
        # If Total > 0: Dilate(Original, Total)
        # If Total < 0: Erode(Original, |Total|)
        # If Total == 0: Original

        total_expansion = border_px + offset_px
        cut_mask = alpha_processed.copy()

        if total_expansion != 0:
            if total_expansion > 0:
                k_cut = get_kernel(total_expansion)
                cut_mask = cv2.dilate(cut_mask, k_cut)
            else:
                k_cut = get_kernel(abs(total_expansion))
                cut_mask = cv2.erode(cut_mask, k_cut)

        # Smoothing Step (Gaussian Blur + Threshold)
        # To smooth the "staircase" pixels from dilation
        cut_mask = cv2.GaussianBlur(cut_mask, (5, 5), 0)
        _, cut_mask = cv2.threshold(cut_mask, 127, 255, cv2.THRESH_BINARY)

        # Supersampling for smooth vector contours
        # Upscale 8x -> find contours -> scale down
        # This reduces pixel-step jaggedness in PDF
        scale_factor = 8.0
        h, w = cut_mask.shape
        cut_mask_up = cv2.resize(cut_mask, (int(w * scale_factor), int(h * scale_factor)), interpolation=cv2.INTER_LINEAR)
        _, cut_mask_up = cv2.threshold(cut_mask_up, 127, 255, cv2.THRESH_BINARY)

        # 3. GENERATE LAYERS

        # Layer 1: Border Body (Bleed)
        # Create full solid color image (using border_color)
        r_b, g_b, b_b = border_color
        border_canvas = Image.new("RGBA", orig_padded.size, (r_b, g_b, b_b, 255))

        # Mask for border body
        mask_pil = Image.fromarray(border_mask, mode="L")

        # Start composite with transparent
        final_comp = Image.new("RGBA", orig_padded.size, (0,0,0,0))

        # Paste Border Color using mask
        final_comp.paste(border_canvas, (0,0), mask_pil)

        # Layer 2: Original Image
        final_comp = Image.alpha_composite(final_comp, orig_padded)

        # Layer 3: Cut Line Stroke (Raster)
        # Use the UPSCALED mask to find contours for better smoothness
        contours_up, hierarchy = cv2.findContours(cut_mask_up, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

        # Smooth contours using approxPolyDP
        smooth_contours = []
        for cnt in contours_up:
            epsilon = 0.0001 * cv2.arcLength(cnt, True) # 0.01% epsilon (Minimal simplification)
            approx = cv2.approxPolyDP(cnt, epsilon, True)

            # Scale back down to original resolution
            # cnt is numpy array of shape (N, 1, 2)
            # We need to divide coordinates by scale_factor
            cnt_down = approx.astype(np.float32) / scale_factor
            # Convert back to int32 for cv2.drawContours (it expects int)
            # But keep float for PDF if possible? No, drawContours needs int.
            # For PDF we can use float.
            smooth_contours.append(cnt_down)

        # For PDF Vector output, we need to return contours and the composite without the stroke
        is_pdf = self.params.get('pdf', False)

        stroke_layer_pil = None
        if not is_pdf:
            # Draw on separate layer (Raster Mode)
            stroke_layer_np = np.zeros((orig_padded.height, orig_padded.width, 4), dtype=np.uint8)

            # Color (R, G, B, A) since we will make PIL Image from it
            r, g, b = stroke_color
            color_tuple = (r, g, b, 255)

            # Apply Smoothing to Raster too?
            # Raster uses cv2.drawContours which draws lines.
            # To match PDF look, we should ideally smooth here too, but cv2 draws poly lines.
            # Let's use the Chaikin smoothed points for raster too if we want parity.
            # BUT: Chaikin returns simple list of points. cv2 needs numpy int32 (N,1,2).

            # For now, keep Raster logic simple (approxPolyDP) as user complained about PDF jaggedness.
            # Convert float contours to int for raster drawing
            int_contours = [cnt.astype(np.int32) for cnt in smooth_contours]

            cv2.drawContours(stroke_layer_np, int_contours, -1, color_tuple, thickness=stroke_px, lineType=cv2.LINE_AA)
            stroke_layer_pil = Image.fromarray(stroke_layer_np, mode="RGBA")
            final_comp = Image.alpha_composite(final_comp, stroke_layer_pil)

        # Crop to content + margin
        # If PDF, we need to crop based on the raster composite (white body + orig)
        # If PNG, we crop based on final with stroke
        bbox = final_comp.getbbox()
        crop_box = None
        if bbox:
            l, t, r, b_ = bbox
            l = max(0, l - 10)
            t = max(0, t - 10)
            r = min(final_comp.width, r + 10)
            b_ = min(final_comp.height, b_ + 10)
            crop_box = (l, t, r, b_)
            final_comp = final_comp.crop(crop_box)

        if is_pdf:
            return final_comp, smooth_contours, crop_box, (orig_padded.height, orig_padded.width)
        else:
            return final_comp

    def stop(self):
        self.is_running = False


class StickerPrepperTab(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.image_paths = []
        self.output_dir = None
        self.output_map = {} # path -> out_path (not fully used in batch but useful for logic)

        # Settings
        self.p_border = 30
        self.p_border_color = (0, 0, 0) # Default Black
        self.p_offset = 0
        self.p_stroke = 2
        self.p_color = (255, 0, 255)

        self.debounce_timer = QTimer()
        self.debounce_timer.setSingleShot(True)
        self.debounce_timer.setInterval(300) # 300ms debounce
        self.debounce_timer.timeout.connect(self.update_preview)

        self.preview_worker = None

        self._setup_ui()

    def _setup_ui(self):
        outer = QVBoxLayout(self)
        outer.setContentsMargins(8,8,8,8)
        outer.setSpacing(6)

        main = QHBoxLayout()
        outer.addLayout(main)

        # --- LEFT SIDEBAR ---
        left = QVBoxLayout()
        main.addLayout(left, 1) # Stretch 1

        # File List
        self.list_w = FileDropListWidget()
        self.list_w.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.list_w.files_dropped.connect(self.add_dropped_files)
        self.list_w.currentItemChanged.connect(self.on_file_changed)

        lbl_files = QLabel("Input Images (Transparent PNG):")
        lbl_files.setStyleSheet("border:none; background:transparent;")
        left.addWidget(lbl_files)
        left.addWidget(self.list_w)

        # Add/Clear Buttons
        btns = QHBoxLayout()
        b_add = QPushButton("Add Images")
        b_add.setIcon(create_plus_icon())
        b_add.clicked.connect(self.add_images)

        b_clr = QPushButton("Clear List")
        b_clr.clicked.connect(self.clear_list)

        btns.addWidget(b_add)
        btns.addWidget(b_clr)
        left.addLayout(btns)

        # Divider
        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setFrameShadow(QFrame.Sunken)
        line.setStyleSheet("border: none; background-color: #b3bcd1; min-height: 1px; max-height: 1px; margin: 10px 0;")
        left.addWidget(line)

        # Settings Group
        grp = QGroupBox("Sticker Settings")
        grp.setStyleSheet("QGroupBox { font-weight: bold; border: 1px solid #b3bcd1; border-radius: 6px; margin-top: 6px; } QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 3px; }")
        glayout = QVBoxLayout(grp)
        glayout.setSpacing(10)

        # Border
        b_layout = QHBoxLayout()
        self.lbl_border = QLabel(f"Border Thickness: {self.p_border}px")
        b_layout.addWidget(self.lbl_border)

        self.btn_border_color = QPushButton()
        self.btn_border_color.setFixedSize(24, 24)
        self.btn_border_color.clicked.connect(self.choose_border_color)
        self._update_border_color_btn()
        b_layout.addWidget(self.btn_border_color)

        self.sl_border = QSlider(Qt.Horizontal)
        self.sl_border.setRange(0, 100)
        self.sl_border.setValue(self.p_border)
        self.sl_border.valueChanged.connect(lambda v: (self.lbl_border.setText(f"Border Thickness: {v}px"), self.on_param_change()))

        # Offset
        self.lbl_offset = QLabel(f"Cut Line Offset: {self.p_offset}px")
        self.sl_offset = QSlider(Qt.Horizontal)
        self.sl_offset.setRange(-50, 50)
        self.sl_offset.setValue(self.p_offset)
        self.sl_offset.valueChanged.connect(lambda v: (self.lbl_offset.setText(f"Cut Line Offset: {v}px"), self.on_param_change()))

        # Stroke
        self.lbl_stroke = QLabel(f"Stroke Width: {self.p_stroke}px")
        self.sl_stroke = QSlider(Qt.Horizontal)
        self.sl_stroke.setRange(1, 20)
        self.sl_stroke.setValue(self.p_stroke)
        self.sl_stroke.valueChanged.connect(lambda v: (self.lbl_stroke.setText(f"Stroke Width: {v}px"), self.on_param_change()))

        # Color
        c_layout = QHBoxLayout()
        c_layout.addWidget(QLabel("Stroke Color:"))
        self.btn_color = QPushButton()
        self.btn_color.setFixedSize(50, 24)
        self.btn_color.clicked.connect(self.choose_color)
        self._update_color_btn()
        c_layout.addWidget(self.btn_color)
        c_layout.addStretch()

        glayout.addLayout(b_layout)
        glayout.addWidget(self.sl_border)
        glayout.addWidget(self.lbl_offset)
        glayout.addWidget(self.sl_offset)
        glayout.addWidget(self.lbl_stroke)
        glayout.addWidget(self.sl_stroke)
        glayout.addLayout(c_layout)

        # PDF Option
        self.chk_pdf = QCheckBox("Output as PDF (Vector Cut Line)")
        if not HAS_REPORTLAB:
            self.chk_pdf.setEnabled(False)
            self.chk_pdf.setText("Output as PDF (ReportLab missing)")
        glayout.addWidget(self.chk_pdf)

        # Smoothing Options
        gsmooth = QGroupBox("Smoothing")
        glayout_s = QVBoxLayout(gsmooth)

        self.chk_smooth_source = QCheckBox("Smooth Source Edges")
        self.chk_smooth_source.setChecked(True)
        self.chk_smooth_source.toggled.connect(self.on_param_change)
        glayout_s.addWidget(self.chk_smooth_source)

        self.lbl_blur = QLabel("Blur Strength: 3")
        self.sl_blur = QSlider(Qt.Horizontal)
        self.sl_blur.setRange(1, 10)
        self.sl_blur.setValue(3)
        self.sl_blur.valueChanged.connect(lambda v: (self.lbl_blur.setText(f"Blur Strength: {v}"), self.on_param_change()))
        glayout_s.addWidget(self.lbl_blur)
        glayout_s.addWidget(self.sl_blur)

        left.addWidget(gsmooth)

        left.addWidget(grp)

        # Output & Process
        left.addSpacing(10)

        l_out = QLabel("OUTPUT FOLDER:")
        l_out.setStyleSheet("font-weight: bold; border: none; background: transparent;")
        left.addWidget(l_out)
        self.out_lbl = QLabel("(auto: LABOKit_Stickers)")
        self.out_lbl.setWordWrap(True)
        self.out_lbl.setStyleSheet("color: #666; margin-bottom: 5px; border: none; background: transparent;")
        left.addWidget(self.out_lbl)

        b_change = QPushButton("Change Folder")
        b_change.clicked.connect(self.change_output_folder)
        left.addWidget(b_change)

        left.addSpacing(5)

        b_proc_all = QPushButton("Process All Images")
        b_proc_all.setStyleSheet("font-weight: bold; padding: 6px;")
        b_proc_all.clicked.connect(self.process_all)
        left.addWidget(b_proc_all)

        # --- RIGHT PREVIEW ---
        right = QVBoxLayout()
        main.addLayout(right, 3) # Stretch 3

        self.preview_widget = ZoomableImageWidget()
        right.addWidget(self.preview_widget)

    # --- UI Logic ---

    def add_images(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Add Images", "", "Images (*.png);;All Files (*)")
        if files: self.add_dropped_files([Path(f) for f in files])

    def add_dropped_files(self, files):
        for p in files:
            if p.suffix.lower() == ".png":
                if p not in self.image_paths:
                    self.image_paths.append(p)
                    item = QListWidgetItem(p.name)
                    item.setData(Qt.UserRole, p)
                    self.list_w.addItem(item)

        if self.list_w.count() > 0 and self.list_w.currentRow() < 0:
            self.list_w.setCurrentRow(0)

    def clear_list(self):
        self.image_paths.clear()
        self.list_w.clear()
        self.preview_widget.set_images(None, None)

    def on_file_changed(self, curr, prev):
        if curr:
            p = curr.data(Qt.UserRole)
            self.update_preview()
        else:
            self.preview_widget.set_images(None, None)

    def on_param_change(self):
        self.p_border = self.sl_border.value()
        self.p_offset = self.sl_offset.value()
        self.p_stroke = self.sl_stroke.value()
        self.debounce_timer.start()

    def choose_color(self):
        c = QColorDialog.getColor(QColor(*self.p_color), self, "Select Stroke Color")
        if c.isValid():
            self.p_color = (c.red(), c.green(), c.blue())
            self._update_color_btn()
            self.on_param_change()

    def choose_border_color(self):
        c = QColorDialog.getColor(QColor(*self.p_border_color), self, "Select Border Color")
        if c.isValid():
            self.p_border_color = (c.red(), c.green(), c.blue())
            self._update_border_color_btn()
            self.on_param_change()

    def _update_color_btn(self):
        r,g,b = self.p_color
        self.btn_color.setStyleSheet(f"background-color: rgb({r},{g},{b}); border: 1px solid #666; border-radius: 4px;")

    def _update_border_color_btn(self):
        r,g,b = self.p_border_color
        self.btn_border_color.setStyleSheet(f"background-color: rgb({r},{g},{b}); border: 1px solid #666; border-radius: 4px;")

    def ensure_out(self, sample_path):
        if not self.output_dir:
            self.output_dir = sample_path.parent / "LABOKit_Stickers"
            self.output_dir.mkdir(exist_ok=True)
            self.out_lbl.setText(str(self.output_dir))
        return self.output_dir

    def change_output_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Select Output Folder")
        if d:
            self.output_dir = Path(d)
            self.out_lbl.setText(str(self.output_dir))

    def get_params(self):
        return {
            "border": self.p_border,
            "border_c": self.p_border_color,
            "offset": self.p_offset,
            "stroke_w": self.p_stroke,
            "stroke_c": self.p_color,
            "pdf": self.chk_pdf.isChecked(),
            "smooth_source": self.chk_smooth_source.isChecked(),
            "blur_strength": self.sl_blur.value()
        }

    def update_preview(self):
        if not self.list_w.currentItem(): return
        p = self.list_w.currentItem().data(Qt.UserRole)

        params = self.get_params()

        # Kill existing preview worker if running?
        # Ideally, wait or cancel.
        # For simplicity, we just start a new one, but let's check.
        # Python threads aren't easily cancellable, but we can set a flag.

        self.preview_worker = StickerWorker([p], None, params, mode="preview", parent=self)
        self.preview_worker.preview_ready.connect(self.on_preview_ready)
        self.preview_worker.start()

    def on_preview_ready(self, pix):
        if not self.list_w.currentItem(): return
        p = self.list_w.currentItem().data(Qt.UserRole)

        # Load original pixmap for comparison toggle
        orig_pix = QPixmap(str(p))
        self.preview_widget.set_image_pixmaps(orig_pix, pix, preserve_zoom=True)

    def process_all(self):
        if not self.image_paths:
            QMessageBox.information(self, "Info", "Please add images first.")
            return

        out = self.ensure_out(self.image_paths[0])
        params = self.get_params()

        self.dlg = QProgressDialog("Processing Stickers...", "Cancel", 0, len(self.image_paths), self)
        self.dlg.setWindowModality(Qt.ApplicationModal)
        self.dlg.setFixedWidth(350)
        self.dlg.show()

        self.batch_worker = StickerWorker(self.image_paths, out, params, mode="process", parent=self)
        self.batch_worker.progress.connect(lambda i, msg: (self.dlg.setValue(i), self.dlg.setLabelText(msg)))
        self.batch_worker.finished.connect(self.on_batch_finished)
        self.batch_worker.error.connect(lambda e: (self.dlg.close(), QMessageBox.critical(self, "Error", e)))
        self.dlg.canceled.connect(self.batch_worker.stop)

        self.batch_worker.start()

    def on_batch_finished(self, cnt):
        self.dlg.close()
        QMessageBox.information(self, "Done", f"Processed {cnt} stickers.\nSaved to: {self.output_dir}")

def create_tab(parent):
    return StickerPrepperTab(parent)
