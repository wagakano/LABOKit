    def _add_slider(self, layout, label, min_val, max_val, default, stage_tag):
        l = QLabel(f"{label}: {default}")
        s = QSlider(Qt.Horizontal); s.setRange(min_val, max_val); s.setValue(default)
        layout.addWidget(l); layout.addWidget(s)
        s.valueChanged.connect(lambda v, lb=l, txt=label: lb.setText(f"{txt}: {v}"))
        s.valueChanged.connect(lambda: self.mark_dirty(stage_tag)) 
        return s

    # --- LOGIC ---
    def mark_dirty(self, stage):
        stages = ["basic", "glitch", "partial", "pattern"]
        if stage in stages:
            idx = stages.index(stage)
            for i in range(idx, len(stages)): self.dirty_flags[stages[i]] = True
        self.trigger_update()

    def trigger_update(self):
        self.wlm_delay_timer.start(3000) 
        self.process_preview()

    def start_wlm_animation(self):
        self.wlm_scramble_count = 0
        self.lbl_wlm.setStyleSheet("QLabel#WLM { color: #ff6600; background-color: #1a1a1a; border: 1px solid #ff6600; }")
        self.wlm_anim_timer.start()

    def update_wlm_digit(self):
        self.lbl_wlm.setText(str(random.uniform(0, 5))[:8])
        self.wlm_scramble_count += 1
        if self.wlm_scramble_count > 10:
            self.wlm_anim_timer.stop()
            final_val = random.choice(self.wlm_values)
            greek = random.choice(["α", "β", "γ", "δ"])
            self.lbl_wlm.setText(f"{final_val}{greek}")
            self.lbl_wlm.setStyleSheet("QLabel#WLM { color: #333; background-color: #e1e6f0; border: 1px solid #9ca7c2; }")

    def clear_image(self):
        self.img_full = None; self.img_preview = None; self.active_file_path = None
        self.preview_widget.set_image_pixmaps(None, None)
        for k in self.cache: self.cache[k] = None

    def open_image(self):
        f, _ = QFileDialog.getOpenFileName(self, "Open Image", "", "Images (*.jpg *.png *.webp *.bmp)")
        if f:
            self.clear_image() 
            self.active_file_path = Path(f)
            try:
                pil_img = Image.open(f).convert("RGB")
                img = np.array(pil_img)
                img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)
                self.img_full = img
                
                h, w = img.shape[:2]
                max_dim = 1280 
                scale = max_dim / w if w > max_dim else 1.0
                if scale < 1.0:
                    new_w, new_h = int(w*scale), int(h*scale)
                    self.img_preview = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)
                else:
                    self.img_preview = img.copy()
                
                for k in self.dirty_flags: self.dirty_flags[k] = True
                self.process_preview()
            except Exception as e: QMessageBox.critical(self, "Error", f"Failed to load image:\n{e}")

    def on_zoom_change(self, val):
        self.lbl_zoom.setText(f"{val}%"); self.preview_widget.set_zoom_level(val / 100.0)

    def on_partial_color_change(self, idx, color): self.mark_dirty("partial")
    
    def on_eyedropper_picked(self, color):
        self.btn_part_col.set_color_silent(color)
        self.mark_dirty("partial")

    def process_preview(self):
        if self.img_preview is None: return
        current_img = self.img_preview.copy()
        
        if self.dirty_flags["basic"] or self.cache["basic"] is None:
            self.cache["basic"] = self._apply_basic(current_img)
            self.dirty_flags["basic"] = False
        current_img = self.cache["basic"].copy()

        if self.dirty_flags["glitch"] or self.cache["glitch"] is None:
            self.cache["glitch"] = self._apply_glitch(current_img)
            self.dirty_flags["glitch"] = False
        current_img = self.cache["glitch"].copy()

        if self.dirty_flags["partial"] or self.cache["partial"] is None:
            if self.chk_part.isChecked(): self.cache["partial"] = self._apply_partial_color(current_img)
            else: self.cache["partial"] = current_img.copy()
            self.dirty_flags["partial"] = False
        current_img = self.cache["partial"].copy()

        if self.chk_pat.isChecked(): current_img = self._apply_pattern(current_img)
        
        self._display_image(current_img)

    def save_image(self):
        if self.img_full is None: return
        last_dir = str(self.active_file_path.parent) if self.active_file_path else ""
        save_path_str, _ = QFileDialog.getSaveFileName(self, "Save Image", last_dir, "PNG Image (*.png);;JPG Image (*.jpg)")
        if not save_path_str: return
        save_path = Path(save_path_str)
        dlg = QProgressDialog("Rendering Full Resolution...", None, 0, 0, self)
        dlg.setWindowModality(Qt.WindowModal); dlg.show(); QApplication.processEvents()
        try:
            res = self.img_full.copy()
            res = self._apply_basic(res)
            res = self._apply_glitch(res)
            if self.chk_part.isChecked(): res = self._apply_partial_color(res)
            if self.chk_pat.isChecked(): res = self._apply_pattern(res)
            
            is_success, buf = cv2.imencode(save_path.suffix, res)
            if is_success:
                buf.tofile(str(save_path))
                dlg.close(); QMessageBox.information(self, "Saved", f"Image saved successfully!")
            else: dlg.close(); QMessageBox.warning(self, "Error", "Failed to save image.")
        except Exception as e: dlg.close(); QMessageBox.critical(self, "Error", str(e))

    def randomize_magic(self):
        mode = self.cb_magic_mode.currentText()
        
        if "Chaos" in mode:
            
            # 1. Adjustments
            self.sl_bright.setValue(random.randint(-40, 40))
            self.sl_contrast.setValue(random.randint(-20, 50))
            self.sl_sat.setValue(random.randint(-50, 50))
            
            # 2. Pattern
            self.chk_pat.setChecked(True) 
            # Pilih tipe pattern, mask, dan blend secara acak dari index yang tersedia
            self.cb_pattern.setCurrentIndex(random.randint(0, self.cb_pattern.count() - 1))
            self.cb_pat_mask.setCurrentIndex(random.randint(0, self.cb_pat_mask.count() - 1))
            self.cb_blend.setCurrentIndex(random.randint(0, self.cb_blend.count() - 1))
            self.sl_pat_scale.setValue(random.randint(1, 8))
            self.sl_pat_spacing.setValue(random.randint(1, 8))
            self.sl_pat_opacity.setValue(random.randint(40, 90)) # Opacity tinggi agar terlihat jelas
            
            # 3. Glitch 
            self.chk_gl_artifact.setChecked(True)
            self.chk_gl_puzzle.setChecked(True)
            self.chk_gl_ghost.setChecked(True)
            self.chk_gl_scan.setChecked(True)
            self.chk_gl_invert.setChecked(True)
            
            self.sl_glitch_amount.setValue(random.randint(30, 95)) # Intensitas tinggi
            self.sl_glitch_seed.setValue(random.randint(0, 100))
            
            # 4. Partial Color 
            self.chk_part.setChecked(True)
            self.sl_part_fuzz.setValue(random.randint(20, 80))
            self.sl_part_sat.setValue(random.randint(0, 60))
            # Pilih warna target acak secara silent
            self.btn_part_col.set_color_silent(QColor(random.randint(0,255), random.randint(0,255), random.randint(0,255)))

        else:
            self.sl_bright.setValue(random.randint(-10, 10))
            self.sl_contrast.setValue(random.randint(0, 15))
            self.sl_sat.setValue(random.randint(5, 20))
            
            # Pattern
            use_pat = random.random() > 0.7 
            self.chk_pat.setChecked(use_pat)
            if use_pat:
                self.cb_pattern.setCurrentIndex(random.randint(0, self.cb_pattern.count() - 1))
                self.cb_blend.setCurrentText("Overlay") # Paksa Overlay biar blend halus
                self.sl_pat_opacity.setValue(random.randint(5, 15))
            
            # Glitch
            self.sl_glitch_amount.setValue(random.randint(5, 15))
            self.chk_gl_artifact.setChecked(random.random() > 0.5)
            self.chk_gl_scan.setChecked(random.random() > 0.5)
            # Matikan glitch yang terlalu kasar
            self.chk_gl_puzzle.setChecked(False)
            self.chk_gl_invert.setChecked(False)
            self.chk_gl_ghost.setChecked(False)
            
        self.mark_dirty("basic")

    def _display_image(self, cv_img):
        rgb = cv2.cvtColor(cv_img, cv2.COLOR_BGR2RGB)
        h, w, ch = rgb.shape
        bytes_per_line = ch * w
        qimg = QImage(rgb.data, w, h, bytes_per_line, QImage.Format_RGB888)
        res_pix = QPixmap.fromImage(qimg)
        
        orig_pix = None
        if self.img_preview is not None:
             rgb_orig = cv2.cvtColor(self.img_preview, cv2.COLOR_BGR2RGB)
             h_o, w_o, ch_o = rgb_orig.shape
             bpl_o = ch_o * w_o
             qo = QImage(rgb_orig.data, w_o, h_o, bpl_o, QImage.Format_RGB888)
             orig_pix = QPixmap.fromImage(qo)

        self.preview_widget.set_image_pixmaps(orig_pix, res_pix, preserve_zoom=True)

    # --- EFFECTS ---
    def _apply_basic(self, img):
        b = self.sl_bright.value(); c = self.sl_contrast.value(); s = self.sl_sat.value()
        if b != 0 or c != 0:
            alpha = (c + 100.0) / 100.0; beta = b 
            img = cv2.convertScaleAbs(img, alpha=alpha, beta=beta)
        if s != 0:
            hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV).astype(np.float32)
            sat_mult = (s + 100.0) / 100.0
            hsv[:,:,1] *= sat_mult; hsv[:,:,1] = np.clip(hsv[:,:,1], 0, 255)
            hsv = hsv.astype(np.uint8); img = cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)
        return img

    def _apply_pattern(self, img):
        pat_type = self.cb_pattern.currentText(); blend_mode = self.cb_blend.currentText(); mask_mode = self.cb_pat_mask.currentText()
        obj_scale = self.sl_pat_scale.value(); spacing_scale = self.sl_pat_spacing.value() 
        opacity = self.sl_pat_opacity.value() / 100.0
        if opacity <= 0: return img
        h, w = img.shape[:2]
        overlay = generate_pattern((h, w, 3), pat_type, obj_scale, spacing_scale)
        alpha_mask = None
        if mask_mode != "Whole Image":
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            if mask_mode == "Dark Areas Only": alpha_mask = 255 - gray
            elif mask_mode == "Light Areas Only": alpha_mask = gray
            alpha_mask = alpha_mask.astype(float) / 255.0
            alpha_mask = cv2.merge([alpha_mask, alpha_mask, alpha_mask])
        blended = blend_images(img, overlay, blend_mode, 1.0)
        if alpha_mask is not None:
            final_factor = alpha_mask * opacity
            res = img * (1.0 - final_factor) + blended * final_factor
            return res.astype(np.uint8)
        else: return cv2.addWeighted(blended, opacity, img, 1.0 - opacity, 0)

    def _apply_glitch(self, img):
        intensity = self.sl_glitch_amount.value(); seed = self.sl_glitch_seed.value()
        if intensity == 0: return img
        np.random.seed(seed); h, w, c = img.shape; out = img.copy()
        if self.chk_gl_artifact.isChecked():
            shift = int((intensity / 100.0) * (w * 0.05)); out[:, :, 2] = np.roll(out[:, :, 2], shift, axis=1); out[:, :, 0] = np.roll(out[:, :, 0], -shift, axis=1) 
        if self.chk_gl_puzzle.isChecked():
            num_slices = int(intensity / 5) + 1; slice_h = h // num_slices
            for i in range(num_slices):
                if np.random.rand() > 0.5:
                    y = i * slice_h; offset = np.random.randint(-50, 50); end_y = min(y+slice_h, h)
                    out[y:end_y, :] = np.roll(out[y:end_y, :], offset, axis=1)
        if self.chk_gl_ghost.isChecked():
            offset_x = int((intensity / 100.0) * 30); offset_y = int((intensity / 100.0) * 10)
            ghost = np.roll(out, offset_x, axis=1); ghost = np.roll(ghost, offset_y, axis=0)
            out = cv2.addWeighted(out, 0.7, ghost, 0.3, 0)
        if self.chk_gl_scan.isChecked():
            noise = np.random.normal(0, intensity, (h, w, c)).astype(np.uint8)
            for y in range(0, h, 4): out[y:min(y+2, h), :] = cv2.add(out[y:min(y+2, h), :], noise[y:min(y+2, h), :])
        if self.chk_gl_invert.isChecked():
            num_blocks = int(intensity / 2)
            for _ in range(num_blocks):
                x = np.random.randint(0, w-50); y = np.random.randint(0, h-50); bw = np.random.randint(20, 100); bh = np.random.randint(20, 100)
                out[y:y+bh, x:x+bw] = 255 - out[y:y+bh, x:x+bw]
        return out

    def _apply_partial_color(self, img):
        target_q = self.btn_part_col.current_color
        tgt_bgr = np.uint8([[[target_q.blue(), target_q.green(), target_q.red()]]])
        tgt_hsv = cv2.cvtColor(tgt_bgr, cv2.COLOR_BGR2HSV)[0][0]
        fuzz = self.sl_part_fuzz.value(); sat_boost = self.sl_part_sat.value()
        hsv_img = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        hue = tgt_hsv[0]
        lower_bound = np.array([max(0, hue - fuzz), 20, 20]); upper_bound = np.array([min(180, hue + fuzz), 255, 255])
        mask = cv2.inRange(hsv_img, lower_bound, upper_bound)
        if hue < fuzz:
            mask2 = cv2.inRange(hsv_img, np.array([180-(fuzz-hue),20,20]), np.array([180,255,255])); mask = cv2.bitwise_or(mask, mask2)
        elif hue > 180 - fuzz:
            mask2 = cv2.inRange(hsv_img, np.array([0,20,20]), np.array([hue+fuzz-180,255,255])); mask = cv2.bitwise_or(mask, mask2)
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY); gray_bgr = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)
        if sat_boost > 0:
            hsv_boost = hsv_img.astype(np.float32)
            hsv_boost[:,:,1] *= (1.0 + sat_boost/50.0); hsv_boost[:,:,1] = np.clip(hsv_boost[:,:,1], 0, 255)
            boosted_bgr = cv2.cvtColor(hsv_boost.astype(np.uint8), cv2.COLOR_HSV2BGR)
        else: boosted_bgr = img
        mask_inv = cv2.bitwise_not(mask)
        colored_part = cv2.bitwise_and(boosted_bgr, boosted_bgr, mask=mask)
        gray_part = cv2.bitwise_and(gray_bgr, gray_bgr, mask=mask_inv)
        return cv2.add(colored_part, gray_part)

def create_tab(parent=None):
    return ImageLabTab(parent)